# Variables for docker compose (copy to .env). Every value has a dev default in docker-compose.yml.
POSTGRES_USER=errandly
POSTGRES_PASSWORD=errandly
POSTGRES_DB=errandly
POSTGRES_PORT=5432

APP_PORT=8080
API_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=8333

S3_ACCESS_KEY_ID=errandly
S3_SECRET_ACCESS_KEY=errandly-dev-secret

LOG_LEVEL=info

