@startuml sd-4-reminders-and-sync
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam maxMessageSize 220
skinparam ResponseMessageBelowArrow true
autonumber

participant "Планувальник\n(@nestjs/schedule)" as Cron
participant "SeriesTopUp" as TopUp
participant "ReminderJobs" as Reminders
participant "NotificationEmails" as Emails
participant "MailService" as Mail
participant "EventDispatcher" as Disp
participant "EventPublicationStore" as Store
participant "CalendarSync" as Cal
participant "Google Calendar API" as Google

== Поповнення серій (FR-21, SYS-12, SYS-25) ==
Cron -> TopUp : щогодини й під час старту
TopUp -> TopUp : кожна серія — до 4 тижнів уперед,\nповторний запуск нічого не дублює

== Нагадування, прострочення й підсумок (FR-38, FR-25) ==
Cron -> Reminders : кожні 5 хв і під час старту
loop Відкриті задачі з терміном у найближчу добу
  opt До терміну не більше за час нагадування виконавця
    Reminders -> Reminders : task_reminders (dueSoon): уже є → пропустити
    Reminders -> Store : подія notification.reminderDue
  end
end
loop Задачі, прострочені за останні 2 доби
  Reminders -> Reminders : task_reminders (overdue): уже є → пропустити
  Reminders -> Reminders : сповіщення taskOverdue
  Reminders -> Store : подія notification.reminderDue
end
loop Хто ввімкнув підсумок і в кого понеділок від 09:00
  Reminders -> Reminders : weekly_digests: уже є → пропустити
  Reminders -> Store : подія notification.digestDue
end
note right of Reminders : кожна задача й користувач —\nокрема коротка транзакція

== Події після коміту (кожні EVENTS_POLL_INTERVAL_MS) ==
Disp -> Store : claimDue(now, ліміт, оренда 5 хв)
note right of Store : зайняті іншим екземпляром\nпублікації пропускаються
loop По одній (ліміти Google API)
  Disp -> Cal : syncTask(taskId) / deleteEvent / resync
  Cal -> Cal : зв'язок із подією (задачу утримано до кінця транзакції)
  Cal -> Google : events.update / insert / delete\nлише в календарі «Errandly»
  alt Успіх
    Cal -> Cal : failedAttempts = 0, lastSyncedAt
    Disp -> Store : complete(id)
  else Доступ відкликано
    Cal -> Cal : syncStatus = paused
    Disp -> Store : complete(id)
  else Помилка (503, мережа)
    Cal -> Cal : failedAttempts + 1
    opt П'ята невдача поспіль (SYS-21)
      Cal -> Cal : syncStatus = paused
      note right of Cal : банер у налаштуваннях (FR-35)
    end
    Disp -> Store : fail(id): наступна спроба\nчерез 30 с / 2 хв / 8 хв / 32 хв
  end
end
Disp -> Emails : reminderDue / digestDue / task.assigned
opt Задача досі за виконавцем і не виконана, лист не вимкнено
  Emails -> Mail : send('taskDueSoon' | 'taskOverdue' | 'weeklyDigest' | 'taskAssigned',\nмова одержувача)
end
note right of Mail : збій SMTP — повтор через 30 с … 32 хв (SYS-22)
@enduml
