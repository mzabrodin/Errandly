@startuml sd-0-3-password-reset
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam maxMessageSize 220
skinparam ResponseMessageBelowArrow true
autonumber

actor "Користувач" as User
participant "React SPA" as SPA
participant "AuthController" as Ctrl
participant "AuthService" as Svc
participant "UsersApi" as Users
participant "AuthRepository" as Repo
participant "SessionService" as Sessions
participant "EventBus" as Bus
participant "AuthEmails" as Emails
participant "MailService" as Mail

User -> SPA : «Забули пароль?», email
SPA -> Ctrl : POST /api/auth/forgot-password
Ctrl -> Svc : forgotPassword(email)
Svc -> Users : findByEmail(email)
opt Обліковий запис є
  Svc -> Bus : publish(auth.passwordResetRequested)
end
Ctrl --> SPA : 204 (завжди, щоб не видати, чи є такий обліковий запис)

== Після коміту, з повторами (SD-4) ==
Bus -> Emails : sendPasswordReset(userId)
Emails -> Repo : retireEmailTokens, insertEmailToken (1 год)
Emails -> Mail : send('resetPassword', посилання)

== Новий пароль (FR-08, NFR-SEC-08) ==
User -> SPA : Новий пароль за посиланням
SPA -> Ctrl : POST /api/auth/reset-password
Ctrl -> Svc : resetPassword(token, password)
group транзакція
  Svc -> Repo : consumeEmailToken(token)
  alt Токен невідомий, прострочений або використаний
    Ctrl --> SPA : 400 TOKEN_INVALID
  else Чинний
    Svc -> Repo : savePassword: новий хеш, зняти блокування
    Svc -> Sessions : revokeAll(userId)
    Ctrl --> SPA : 204
  end
end
@enduml
