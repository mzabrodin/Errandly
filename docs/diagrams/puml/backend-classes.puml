@startuml backend-classes
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam TitleFontStyle bold
skinparam RoundCorner 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1F6F64
skinparam ObjectBackgroundColor #FFFFFF
skinparam ObjectBorderColor #1F6F64
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #1F6F64
skinparam NoteBackgroundColor #FFFFE0
hide empty members
skinparam packageStyle rectangle

package Controllers {
  class AuthController {
    +register(dto)
    +login(dto)
    +logout()
    +verifyEmail(token)
    +forgotPassword(dto)
    +resetPassword(dto)
  }
  class MeController {
    +updateProfile(dto)
    +deleteAccount()
  }
  class AvatarController {
    +uploadAvatar(file)
    +deleteAvatar()
  }
  class GroupsController {
    +create(dto)
    +get(groupId)
    +updateMember(groupId, userId, dto)
    +removeMember(groupId, userId)
    +leave(groupId)
  }
  class InvitesController {
    +create(groupId, dto)
    +info(token)
    +accept(token)
  }
  class TasksController <<заплановано>> {
    +create(groupId, dto)
    +update(taskId, scope, dto)
    +complete(taskId)
    +undoComplete(taskId)
    +assign(taskId, dto)
  }
}

package Services {
  class AuthService {
    +register(dto)
    +login(dto)
    +verifyEmail(token)
    +resetPassword(token, password)
  }
  class SessionService {
    +create(userId)
    +authenticate(token)
    +revokeAll(userId, keepId)
  }
  class UsersService {
    +updateProfile(userId, dto)
    +deleteAccount(userId)
  }
  class AvatarsService {
    +upload(userId, file)
    +remove(userId)
  }
  class GroupsService {
    +create(userId, name)
    +changeRole(groupId, actorId, userId, role)
    +removeMember(groupId, actorId, userId)
    +leave(groupId, userId)
  }
  class InvitesService {
    +create(groupId, actorId, email)
    +info(token, viewerId)
    +accept(token, userId)
  }
  class AbsencesService {
    +add(groupId, userId, from, to)
    +remove(groupId, userId, id)
  }
  class TasksService <<заплановано>> {
    +create(groupId, userId, input)
    +complete(taskId, userId)
    +undoComplete(taskId, userId)
  }
  class UsersApi <<фасад>> {
    +findById(id)
    +findMany(ids)
    +setProviderAvatar(id, url)
  }
  class GroupsApi <<фасад>> {
    +requireMember(groupId, userId)
    +requireAdmin(groupId, userId)
    +members(groupId)
  }
  class AuthEmails <<слухач>>
  class InviteEmails <<слухач>>
  class MailService {
    +send(template, to, data, locale)
  }
}

package "Спільне ядро" {
  class EventBus {
    +publish(tx, type, event)
    +onInTransaction(type, listener)
    +onAfterCommit(type, id, listener)
  }
  class EventDispatcher {
    +dispatchDue()
  }
  class EventPublicationStore {
    +add(tx, rows)
    +claimDue(now, limit, lease)
  }
}

package "Порти й адаптери" {
  abstract class PasswordHasher
  class Argon2PasswordHasher
  abstract class MailTransport
  class SmtpMailTransport
  abstract class ObjectStorage
  class S3ObjectStorage
  abstract class CalendarGateway
  class GoogleCalendarGateway
  interface AssignmentStrategy <<заплановано>>
  class LeastLoadRotationStrategy <<заплановано>>
  abstract class Clock
}

package Repositories {
  class UsersRepository
  class AuthRepository
  class GroupsRepository
  class TasksRepository <<заплановано>>
}

AuthController ..> AuthService
MeController ..> UsersService
AvatarController ..> AvatarsService
GroupsController ..> GroupsService
InvitesController ..> InvitesService
TasksController ..> TasksService

AuthService ..> SessionService
AuthService ..> UsersApi
AuthService ..> PasswordHasher
AuthService ..> AuthRepository
AuthService ..> EventBus
UsersService ..> UsersRepository
UsersService ..> EventBus
AvatarsService ..> ObjectStorage
AvatarsService ..> UsersRepository
GroupsService ..> GroupsRepository
GroupsService ..> UsersApi
InvitesService ..> GroupsApi
InvitesService ..> GroupsRepository
AbsencesService ..> GroupsRepository
TasksService ..> GroupsApi
TasksService ..> AssignmentStrategy
TasksService ..> TasksRepository
TasksService ..> EventBus
GroupsApi ..> GroupsRepository
UsersApi ..> UsersRepository
AuthEmails ..> MailService
InviteEmails ..> MailService
MailService ..> MailTransport
EventBus ..> EventPublicationStore
EventDispatcher ..> EventPublicationStore
EventDispatcher ..> EventBus

Argon2PasswordHasher -up-|> PasswordHasher
SmtpMailTransport -up-|> MailTransport
S3ObjectStorage -up-|> ObjectStorage
GoogleCalendarGateway -up-|> CalendarGateway
LeastLoadRotationStrategy .up.|> AssignmentStrategy
@enduml
