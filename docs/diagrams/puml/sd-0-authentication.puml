@startuml sd-0-authentication
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam maxMessageSize 220
skinparam ResponseMessageBelowArrow true
autonumber

actor "Гість" as User
participant "React SPA" as SPA
participant "AuthController" as Ctrl
participant "AuthService" as Svc
participant "SessionService" as Sessions
participant "PasswordHasher\n(Argon2id)" as Hasher
database "PostgreSQL" as DB
participant "EventDispatcher" as Disp
participant "AuthEmails" as Emails
participant "MailService" as Mail

== Реєстрація (FR-01–04) ==
User -> SPA : Ім'я, email, пароль
SPA -> Ctrl : POST /api/auth/register
alt Пароль слабкий або поле порожнє (FR-03)
  Ctrl --> SPA : 400 VALIDATION + fields
else Дані коректні
  Ctrl -> Svc : register(dto)
  Svc -> Hasher : hash(password)
  Svc -> DB : BEGIN; INSERT users, password_credentials
  alt Email уже зайнятий (FR-02)
    Svc --> Ctrl : EMAIL_TAKEN
    Ctrl --> SPA : 409
  else Новий обліковий запис
    Svc -> DB : INSERT event_publications\n(auth.emailVerificationRequested)
    Svc -> Sessions : create(userId, tx)
    Sessions -> DB : INSERT sessions (SHA-256 токена, +30 днів)
    Svc -> DB : COMMIT
    Ctrl --> SPA : 201 User + Set-Cookie errandly_session (HttpOnly)
  end
end
opt Після коміту, з повторами (SD-4)
  Disp -> Emails : sendVerification(userId)
  Emails -> DB : відкликати старі токени, INSERT email_tokens (48 год)
  Emails -> Mail : send('verifyEmail', email, посилання, мова)
end

== Вхід (FR-05–06) ==
User -> SPA : Email і пароль
SPA -> Ctrl : POST /api/auth/login
Ctrl -> Svc : login(dto)
Svc -> DB : знайти користувача й облікові дані
alt Невідомий email
  Svc -> Hasher : verify(password, фіктивний хеш)
  note right : однаковий час відповіді\nдля відомих і невідомих email
  Ctrl --> SPA : 401 INVALID_CREDENTIALS
else Обліковий запис заблоковано
  Ctrl --> SPA : 423 ACCOUNT_LOCKED + retryAfterSeconds
else Пароль хибний
  Svc -> DB : failedLogins + 1; на 5-й — lockedUntil = +15 хв
  Ctrl --> SPA : 401 INVALID_CREDENTIALS (або 423 на 5-й спробі)
else Пароль правильний
  Svc -> DB : скинути лічильник спроб
  Svc -> Sessions : create(userId)
  Ctrl --> SPA : 200 User + Set-Cookie
end

== Кожен наступний запит ==
SPA -> Ctrl : будь-який /api/... з cookie
Ctrl -> Sessions : SessionGuard: authenticate(token)
alt Сесії немає або вона прострочена (SYS-07)
  Sessions -> DB : видалити прострочену сесію
  Ctrl --> SPA : 401 UNAUTHENTICATED
else Чинна сесія
  opt Минула година від останнього продовження
    Sessions -> DB : expiresAt = now + 30 днів
    Ctrl --> SPA : оновлений Set-Cookie
  end
end

== Відновлення пароля (FR-08) ==
User -> SPA : «Забули пароль?», email
SPA -> Ctrl : POST /api/auth/forgot-password
Ctrl --> SPA : 204 (завжди, щоб не видати, чи є такий обліковий запис)
opt Обліковий запис є (після коміту)
  Disp -> Emails : sendPasswordReset(userId)
  Emails -> Mail : send('resetPassword', посилання на 1 год)
end
User -> SPA : Новий пароль за посиланням
SPA -> Ctrl : POST /api/auth/reset-password
Ctrl -> Svc : resetPassword(token, password)
alt Токен невідомий, прострочений або використаний
  Ctrl --> SPA : 400 TOKEN_INVALID
else Токен чинний
  Svc -> DB : BEGIN; використати токен, новий хеш,\nзняти блокування, видалити всі сесії; COMMIT
  Ctrl --> SPA : 204
end
@enduml
