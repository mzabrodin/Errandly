@startuml sd-2-invite-and-join
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam TitleFontStyle bold
skinparam maxMessageSize 220
skinparam ResponseMessageBelowArrow true
autonumber

actor "Адміністратор" as Admin
actor "Гість" as Guest
participant "React SPA" as SPA
participant "InvitesController" as Ctrl
participant "InvitesService" as Svc
participant "GroupsApi" as Access
database "PostgreSQL" as DB
participant "EventDispatcher" as Disp
participant "InviteEmails" as Emails
participant "MailService" as Mail

== Створення запрошення (FR-11) ==
Admin -> SPA : Натискає «Запросити»,\nвказує email (необов'язково)
SPA -> Ctrl : POST /api/groups/:groupId/invites
Ctrl -> Svc : create(groupId, actorId, email)
Svc -> DB : BEGIN
Svc -> Access : requireAdmin(groupId, actorId, tx)
alt Не учасник або не адміністратор
  Access --> Svc : DomainError
  Svc --> Ctrl : 403 FORBIDDEN / ADMIN_ONLY
  Ctrl --> SPA : 403
else Адміністратор
  Svc -> DB : INSERT invites (SHA-256 токена, expiresAt = +7 днів)
  opt Email вказано
    Svc -> DB : INSERT event_publications\n(group.inviteEmailRequested)
  end
  Svc -> DB : COMMIT
  Svc --> Ctrl : InviteDto (url, expiresAt)
  Ctrl --> SPA : 201
  SPA --> Admin : Показує посилання для копіювання
end

opt Після коміту, з повторами (SD-4)
  Disp -> Emails : send(groupId, email, invitedBy, expiresAt)
  Emails -> DB : відкликати попередні листи на цю адресу,\nINSERT invites з новим токеном
  Emails -> Mail : send('invite', email, data, мова одержувача)
end

== Приєднання за посиланням (FR-12–14) ==
Guest -> SPA : Відкриває /invite/:token
SPA -> Ctrl : GET /api/invites/:token
Ctrl -> Svc : info(token, viewerId)
Svc -> DB : знайти invite за SHA-256 токена
alt Прострочене або відкликане (FR-13)
  Svc --> Ctrl : INVITE_INVALID
  Ctrl --> SPA : 410
  SPA --> Guest : «Запрошення недійсне»
else Дійсне
  Svc --> Ctrl : InviteInfo (назва групи, хто запросив, alreadyMember)
  Ctrl --> SPA : 200
  opt Гість не автентифікований
    SPA --> Guest : Вхід або реєстрація з next=/invite/:token
  end
  Guest -> SPA : Підтверджує приєднання
  SPA -> Ctrl : POST /api/invites/:token/accept
  Ctrl -> Svc : accept(token, userId)
  alt Email не підтверджено
    Svc --> Ctrl : EMAIL_NOT_VERIFIED
    Ctrl --> SPA : 403
  else Підтверджено
    Svc -> DB : BEGIN; SELECT memberships FOR UPDATE
    alt Уже учасник (FR-14)
      Svc -> DB : COMMIT (нічого не змінено)
    else Новий учасник
      Svc -> DB : INSERT memberships (role member, перший вільний колір)
      Svc -> DB : INSERT event_publications (group.memberJoined)
      Svc -> DB : COMMIT
    end
    Svc --> Ctrl : { groupId }
    Ctrl --> SPA : 200
    SPA --> Guest : Відкриває робочий екран групи
  end
end
@enduml
