@startuml states
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam ArrowColor #1F6F64
skinparam StateBackgroundColor #DCEEEA
skinparam StateBorderColor #1F6F64
skinparam NoteBackgroundColor #FFFFE0

state "Задача (статус обчислюється, FR-23–25)" as Task {
  state "Заплановано" as Planned
  state "Не призначено" as Unassigned
  state "Прострочено" as Overdue
  state "Виконано" as Done

  [*] --> Planned : створено з виконавцем
  [*] --> Unassigned : немає доступних учасників (FR-29)
  Unassigned --> Planned : адмін призначив вручну /\nучасник повернувся
  Planned --> Unassigned : виконавець вийшов із групи,\nзамінити нікому
  Planned --> Overdue : термін минув (FR-25)
  Unassigned --> Overdue : термін минув
  Planned --> Done : виконавець позначив (FR-24)
  Overdue --> Done : виконавець позначив
  Done --> Planned : скасування: виконавець ≤ 24 год,\nадмін будь-коли [термін не минув]
  Done --> Overdue : скасування [термін минув]
  Done --> [*] : видалено разом із серією
}

state "Синхронізація календаря (SYS-20–21)" as Sync {
  state "Не підключено" as Disconnected
  state "ok" as Ok
  state "Повтор" as Retrying
  state "paused" as Paused

  [*] --> Disconnected
  Disconnected --> Ok : учасник підключив Google Calendar (FR-32)
  Ok --> Retrying : помилка API
  Retrying --> Ok : повтор успішний
  Retrying --> Retrying : помилка, наступна спроба\nчерез 30 с / 2 хв / 8 хв / 32 хв
  Retrying --> Paused : 5-та невдача або\nдоступ відкликано
  Paused --> Ok : повторне підключення /\n«Синхронізувати зараз»
  Ok --> Disconnected : відключено, токени видалено
  Paused --> Disconnected : відключено
}

note right of Paused
  Користувач бачить банер
  «Синхронізацію з календарем
  призупинено» (FR-35)
end note
@enduml
