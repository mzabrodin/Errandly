@startuml shared-kernel
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam RoundCorner 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1F6F64
skinparam packageStyle rectangle
hide empty members

package "Спільне ядро" {
  class EventBus {
    +publish(tx, type, event)
    +onInTransaction(type, listener)
    +onAfterCommit(type, id, listener)
  }
  class EventDispatcher {
    +tick()
    +dispatchDue()
  }
  class EventPublicationStore {
    +add(tx, rows)
    +claimDue(now, limit, leaseUntil)
    +complete(id, at)
    +fail(id, …)
    +countOverdue(before)
    +release(ids, at)
    +purge(now)
  }
  class ExclusiveRunner {
    +run(job)
    +stop()
    +isStopping
  }
  class ShutdownState {
    +isClosing
    +onModuleDestroy()
  }
  class CallerThrottlerGuard <<APP_GUARD>> {
    #getTracker(request)
  }
  class TokenCipher {
    +encrypt(plain)
    +decrypt(sealed)
  }
  class "Transitions<S>" as Transitions {
    +decide(from, to)
  }
  class DataRetention {
    +register(owner, purge)
    +purge()
  }
  abstract class Clock {
    +now()
  }
  class SystemClock
  class DomainError {
    +code
    +details
  }
  class ApiExceptionFilter <<APP_FILTER>>
  class GoogleClients {
    +oauthClient(callbackPath)
    +client(refreshToken)
  }
}

package "Порти й адаптери" {
  abstract class PasswordHasher {
    +hash(password)
    +verify(password, stored)
  }
  class Argon2PasswordHasher
  abstract class MailTransport {
    +send(mail)
    +verify()
  }
  class SmtpMailTransport
  abstract class ObjectStorage {
    +put(key, body, type)
    +get(key)
    +delete(key)
    +ping()
  }
  class S3ObjectStorage
  abstract class CalendarGateway {
    +createCalendar(token, name, zone)
    +deleteCalendar(access)
    +listEventIds(access)
    +upsertEvent(access, id, event)
    +deleteEvent(access, id)
  }
  class GoogleCalendarGateway
}

class MailService {
  +send(template, to, data, locale)
}

EventBus ..> EventPublicationStore
EventDispatcher ..> EventPublicationStore
EventDispatcher ..> EventBus
DataRetention ..> Clock
DataRetention ..> ExclusiveRunner
EventDispatcher ..> ExclusiveRunner
ApiExceptionFilter ..> DomainError
MailService ..> MailTransport
SystemClock -up-|> Clock
Argon2PasswordHasher -up-|> PasswordHasher
SmtpMailTransport -up-|> MailTransport
S3ObjectStorage -up-|> ObjectStorage
GoogleCalendarGateway -up-|> CalendarGateway
GoogleCalendarGateway ..> GoogleClients
@enduml
