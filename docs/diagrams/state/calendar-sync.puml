@startuml calendar-sync
skinparam shadowing false
skinparam defaultFontName "Inter, Segoe UI, Arial"
skinparam ArrowColor #1F6F64
skinparam StateBackgroundColor #DCEEEA
skinparam StateBorderColor #1F6F64
skinparam NoteBackgroundColor #FFFFE0

state "Не підключено" as Disconnected
state "ok" as Ok
state "Повтор" as Retrying
state "paused" as Paused

[*] --> Disconnected
Disconnected --> Ok : учасник підключив Google Calendar,\nстворено календар «Errandly» (FR-32)
Ok --> Retrying : помилка API
Ok --> Paused : доступ відкликано
Retrying --> Ok : повтор успішний
Retrying --> Retrying : помилка, наступна спроба\nчерез 30 с / 2 хв / 8 хв / 32 хв
Retrying --> Paused : 5-та невдача поспіль (SYS-21)
Paused --> Ok : повторне підключення /\n«Синхронізувати», звірка календаря
Ok --> Disconnected : відключено чи акаунт видалено:\nтокени й календар «Errandly» видалено
Paused --> Disconnected : відключено

note right of Paused
  Користувач бачить банер
  «Синхронізацію з календарем
  призупинено» (FR-35)
end note
@enduml
