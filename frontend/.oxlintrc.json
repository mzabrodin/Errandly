{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "react", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "typescript/consistent-type-imports": "error",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/pages/**", "**/app/**"],
                "message": "shared must not depend on pages or app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**", "src/features/**", "src/layouts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "date-fns",
                "message": "Use shared/lib/dates, which works in the profile time zone."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "date-fns",
                "message": "Use shared/lib/dates, which works in the profile time zone."
              }
            ],
            "patterns": [{ "group": ["**/app/**"], "message": "pages must not depend on app." }]
          }
        ]
      }
    }
  ]
}
