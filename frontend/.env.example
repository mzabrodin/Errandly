# Origin of the API, without /api. Empty by default: requests go to the same origin
# (the Vite proxy in dev, nginx in Docker). Only VITE_* values reach the browser — never put secrets here.
# VITE_API_URL=http://localhost:3000

# Mock API (MSW): on by default in dev; false uses the real backend
# VITE_USE_MOCKS=false
