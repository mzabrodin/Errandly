{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run css:types && tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "preview": "vite preview",
    "api:generate": "npx --yes openapi-typescript@7.13.0 ../backend/openapi.json -o src/shared/api/schema.d.ts",
    "css:types": "node scripts/css-module-types.mjs",
    "typecheck": "node scripts/css-module-types.mjs --check && tsc -b",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.10",
    "lucide-react": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.1.3",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
