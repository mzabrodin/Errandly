{
  "name": "backend",
  "version": "0.0.1",
  "description": "Errandly API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "openapi:export": "nest build && node dist/openapi.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@date-fns/tz": "^1.5.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
