# Backend running on the host (npm run dev:backend). Copy to backend/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Public origin of the app; CORS, OAuth callbacks and links in emails are built from it
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://errandly:errandly@localhost:5432/errandly
# How often after-commit events (calendar sync, emails) are delivered; 0 turns delivery off
EVENTS_POLL_INTERVAL_MS=2000
# Hourly jobs, such as topping up recurring tasks 4 weeks ahead
SCHEDULER_ENABLED=true
# Requests per minute per account (per IP without a session): any route, and the strict ones
# such as sign-in, passwords, emails and Google calls (NFR-SEC-07)
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
# A graceful shutdown that takes longer exits with 1; keep it below the compose stop_grace_period
SHUTDOWN_TIMEOUT_MS=20000

# Mailpit from docker compose; web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Errandly <no-reply@errandly.local>"
# SMTP_USER=
# SMTP_PASS=
# Dev endpoint /api/dev/mail for the frontend mock API; works only with a local SMTP host
MAIL_DEV_API=true

# Avatar storage: SeaweedFS from docker compose; R2, AWS S3 or Supabase Storage need only other values
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=errandly
S3_SECRET_ACCESS_KEY=errandly-dev-secret
# S3_REGION=us-east-1
# S3_BUCKET=avatars

# Google OAuth client for sign-in and the calendar. Redirect URIs to register:
# http://localhost:5173/api/auth/oauth/google/callback and http://localhost:5173/api/me/calendar/callback.
# Without it Google sign-in returns to the login page with an error and connecting a calendar
# answers 503. Secrets: never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts the stored Google tokens; required in production (openssl rand -base64 32)
# TOKEN_ENCRYPTION_KEY=
