# Backend running on the host (npm run dev:backend). Copy to backend/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Public origin of the app; CORS, OAuth callbacks and links in emails are built from it
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://errandly:errandly@localhost:5432/errandly
# How often after-commit events (calendar sync, emails) are delivered; 0 turns delivery off
EVENTS_POLL_INTERVAL_MS=2000
# Requests per minute from one IP: any route, and sign-in/password reset/emails (NFR-SEC-07)
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# Mailpit from docker compose; web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Errandly <no-reply@errandly.local>"
# SMTP_USER=
# SMTP_PASS=
# Dev endpoint /api/dev/mail for the frontend mock API; works only with a local SMTP host
MAIL_DEV_API=true

# Coming with the calendar module (secrets: never commit real values)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
