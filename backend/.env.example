# Backend running on the host (npm run dev:backend). Copy to backend/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Public origin of the app; CORS, OAuth callbacks and links in emails are built from it
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://errandly:errandly@localhost:5432/errandly

# Mailpit from docker compose; web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Errandly <no-reply@errandly.local>"
# SMTP_USER=
# SMTP_PASS=
# Dev endpoint /api/dev/mail for the frontend mock API; works only with a local SMTP host
MAIL_DEV_API=true

# Coming with the auth and calendar modules (secrets: never commit real values)
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
